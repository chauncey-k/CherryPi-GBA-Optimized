+#ifdef CHERRYPI
+/* The private mapping keeps guest pointers stable while Linux can reclaim
+ * clean ROM pages. RTC writes become private copies, never writes to the ROM.
+ * Only complete 32KiB guest pages are mapped: no accesses past file EOF. */
+static size_t cp_rom_mapping_size;
+
+static void cp_release_rom_buffer(void)
+{
+  if(cp_rom_mapping_size)
+    munmap(gamepak_rom, cp_rom_mapping_size);
+  else
+    free(gamepak_rom);
+  cp_rom_mapping_size = 0;
+  gamepak_rom = NULL;
+  free(gamepak_memory_map);
+  gamepak_memory_map = NULL;
+}
+
+static void cp_reset_heap_rom(void)
+{
+  if(cp_rom_mapping_size)
+  {
+    cp_release_rom_buffer();
+    init_gamepak_buffer();
+  }
+}
+
+static void cp_refresh_rom_regions(void)
+{
+  unsigned i;
+  for(i = 8; i <= 13; i++)
+    memory_regions[i] = gamepak_rom + ((i & 1) ? 0xFFFFFF : 0);
+}
+#endif
