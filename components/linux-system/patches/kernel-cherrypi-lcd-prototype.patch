+/* PCB wiring: B3..7, G2..7, R3..7, plus CLK/DE/HSYNC/VSYNC.
+ * PD0 and PD12 are deliberately left out (touch I2C on Cherry Pi).
+ */
+&pio {
+    lcd_rgb565_pins: lcd-rgb565-pins {
+        pins = "PD1", "PD2", "PD3", "PD4", "PD5",
+               "PD6", "PD7", "PD8", "PD9", "PD10", "PD11",
+               "PD13", "PD14", "PD15", "PD16", "PD17",
+               "PD18", "PD19", "PD20", "PD21";
+        function = "lcd";
+    };
+};
+
+&tcon0 {
+    pinctrl-names = "default";
+    pinctrl-0 = <&lcd_rgb565_pins>;
+    status = "okay";
+};
+
+&tcon0_out {
+    tcon0_out_panel: endpoint@0 {
+        reg = <0>;
+        remote-endpoint = <&panel_in>;
+        allwinner,tcon-channel = <0>;
+    };
+};
