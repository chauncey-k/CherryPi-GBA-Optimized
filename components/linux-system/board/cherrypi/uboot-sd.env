# Cherry Pi SD-only serial prototype, 64 MiB DRAM at 0x80000000.
stdin=serial
stdout=serial
stderr=serial
baudrate=115200
bootdelay=2
loadaddr=0x81000000
kernel_addr_r=0x81000000
fdt_addr_r=0x81600000
fdt_high=0x81700000
bootm_size=0x01700000
scriptaddr=0x81800000
bootcmd=if mmc dev 0; then if load mmc 0:1 ${scriptaddr} boot.scr; then source ${scriptaddr}; fi; fi
