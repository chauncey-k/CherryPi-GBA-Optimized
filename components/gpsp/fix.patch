+/* The six patch columns in the game's eight-sample ARM mixing loop.
+ * Eligibility is semantic: every listed variant is emitted, not just the
+ * instruction present while translating. Unsupported writes still flush. */
+static const u32 cp_live_words[6][3] = {
+  {0xe1a09b49,0xe0969bc9,0xe0969bc9},
+  {0xe0999086,0xe08c6006,0xe0877004},
+  {0xe0977004,0xe0977004,0xe0833ba7},
+  {0x508c6006,0x51f360d1,0xe1d360d0},
+  {0x51f3c0d1,0xe1f3c0d1,0xe1f3c0d1},
+  {0x505cc006,0xe05cc006,0xe05cc006}
+};
+static u8 cp_live_ready[0x2000], cp_live_blocked[0x2000];
+extern unsigned cp_smc_write_trace[4];
+extern unsigned cp_live_smc_skipped;
+static int cp_live_column(u32 pc)
+{
+  u32 off, sample;
+  if((pc >> 24) != 3 || (pc & 3)) return -1;
+  off = pc & 0x7fff;
+  if(off >= 0x2178) off -= 0x98;
+  if(off < 0x20e0 || off > 0x2164) return -1;
+  off -= 0x20e0;
+  sample = off / 0x24;
+  if(sample >= 4) return -1;
+  off %= 0x24;
+  if(off == 0) return 0;
+  if(off == 4) return 1;
+  if(off >= 0x0c && off <= 0x18) return 2 + (off - 0x0c) / 4;
+  return -1;
+}
+static int cp_live_allowed(unsigned col, u32 word)
+{
+  return word == cp_live_words[col][0] || word == cp_live_words[col][1] ||
+         word == cp_live_words[col][2];
+}
+/* Called only after a changed, guarded 32-bit CPU store. The preceding stores
+ * in STM use the unguarded safe helper, so validate the WHOLE STM group. */
+unsigned cp_live_store(u32 host, u32 resume_pc)
+{
+  u32 offset, first, n, i;
+  if(host < (u32)(iwram + 0x8000) || host >= (u32)(iwram + 0x10000)) return 0;
+  offset = host - (u32)(iwram + 0x8000);
+  if(resume_pc == 0x030020a0 || resume_pc == 0x030020a8) n = 2;
+  else if(resume_pc == 0x030020b0 || resume_pc == 0x030020b8) n = 4;
+  else return 0;
+  if(offset & 3 || offset < (n - 1) * 4) return 0;
+  first = offset - (n - 1) * 4;
+  for(i = 0; i < n; i++) {
+    u32 at = first + i * 4;
+    int col = cp_live_column(0x03000000 + at);
+    if(col != (n == 2 ? i : i + 2) || !cp_live_ready[at >> 2] ||
+       cp_live_blocked[at >> 2] ||
+       !cp_live_allowed(col, address32(iwram, 0x8000 + at))) return 0;
+  }
+  cp_live_smc_skipped++;
+  cp_smc_write_trace[3] = 0;
+  return 1;
+}
