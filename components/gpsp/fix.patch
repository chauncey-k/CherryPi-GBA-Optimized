+/* A finite set of live ARM opcodes, selected without changing guest NZCV.
+ * No native code is patched at runtime, so no additional I-cache sync is needed. */
+#define translate_arm_instruction()                                          \
+{                                                                            \
+  check_pc_region(pc);                                                       \
+  int live_column = cp_live_column(pc);                                      \
+  u32 live_word = address32(pc_address_block, pc & 0x7fff);                   \
+  if(live_column >= 0 && cp_live_allowed(live_column, live_word) &&           \
+     !cp_live_blocked[(pc & 0x7fff) >> 2])                                   \
+  {                                                                          \
+    u8 *choices[3], *ends[3];                                                \
+    u32 k;                                                                   \
+    if((last_condition & 15) != 14)                                         \
+      generate_branch_patch_conditional(backpatch_address, translation_ptr); \
+    generate_cycle_update();                                                \
+    generate_save_flags();                                                  \
+    generate_load_pc(reg_a0, (u32)(iwram + 0x8000 + (pc & 0x7fff)));         \
+    ARM_LDR_IMM(0, reg_a0, reg_a0, 0);                                     \
+    for(k = 0; k < 3; k++)                                                  \
+    {                                                                        \
+      generate_load_pc(reg_a1, cp_live_words[live_column][k]);               \
+      ARM_CMP_REG_REG(0, reg_a0, reg_a1);                                   \
+      generate_branch_filler(ARMCOND_EQ, choices[k]);                        \
+    }                                                                        \
+    /* Even an unguarded preceding STM store cannot execute a stale variant. */\
+    generate_restore_flags();                                               \
+    generate_function_call(cp_live_unknown_arm);                             \
+    write32(pc);                                                            \
+    for(k = 0; k < 3; k++)                                                  \
+    {                                                                        \
+      generate_branch_patch_conditional(choices[k], translation_ptr);        \
+      generate_restore_flags();                                             \
+      opcode = cp_live_words[live_column][k];                               \
+      condition = opcode >> 28;                                             \
+      if(condition != 14) { arm_conditional_block_header(); }               \
+      translate_arm_opcode_body();                                          \
+      generate_cycle_update();                                              \
+      if((opcode >> 28) != 14)                                              \
+        generate_branch_patch_conditional(backpatch_address, translation_ptr);\
+      generate_branch_filler(ARMCOND_AL, ends[k]);                           \
+    }                                                                        \
+    for(k = 0; k < 3; k++)                                                  \
+      generate_branch_patch_conditional(ends[k], translation_ptr);           \
+    cp_live_ready[(pc & 0x7fff) >> 2] = 1;                                 \
+    condition = last_condition = 14;                                        \
+  }                                                                          \
+  else                                                                       \
+  {                                                                          \
+    translate_arm_instruction_header();                                     \
+    translate_arm_opcode_body();                                            \
+  }                                                                          \
+  pc += 4;                                                                  \
+}
 
